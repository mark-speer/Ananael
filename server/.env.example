# Server — local Vite/API dev uses 5000; Docker Compose production uses 443
PORT=5000

# MongoDB — use the Compose service alias in Docker; localhost for local dev
MONGO_URI=mongodb://mongo:27017/ananael

# JWT signing secret — required, min 32 characters (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret!!

# Allowed browser origin(s), comma-separated.
# Compose (UI+API on :443): https://localhost  (or your public https://host)
# Vite local (client :5173 → API :5000): http://localhost:5173
# Do not use * in production with cookie auth / CSRF.
CLIENT_ORIGIN=http://localhost:5173

# Set to true behind HTTPS so the HttpOnly auth cookie is marked Secure
COOKIE_SECURE=false

# Optional TLS (Compose on :443). Paths are inside the container when using the certs volume.
# SSL_CERT_PATH=/certs/fullchain.pem
# SSL_KEY_PATH=/certs/privkey.pem
