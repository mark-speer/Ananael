# Server — local Vite/API and Docker Compose both use 5000
PORT=5000

# MongoDB — use the Compose service alias in Docker; localhost for local dev
MONGO_URI=mongodb://mongo:27017/ananael

# JWT signing secret — required, min 32 characters (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-secret!!

# Allowed browser origin(s), comma-separated.
# Production: https://ananael.tech,https://www.ananael.tech
# Vite local: http://localhost:5173
# Do not use * in production with cookie auth / CSRF.
CLIENT_ORIGIN=http://localhost:5173

# Set to true only when the browser reaches this app over HTTPS
# Production (ananael.tech): true
COOKIE_SECURE=false

# Optional TLS. Files must exist or the server stays on HTTP.
# SSL_CERT_PATH=/certs/fullchain.pem
# SSL_KEY_PATH=/certs/privkey.pem
