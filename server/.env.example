# Server
PORT=5000

# MongoDB — use the Compose service alias in Docker; localhost for local dev
MONGO_URI=mongodb://mongo:27017/ananael

# JWT signing secret — change this in production
JWT_SECRET=change-me-to-a-long-random-secret

# Allowed browser origin(s), comma-separated — use * when UI is served from this same server
CLIENT_ORIGIN=*
